# Telegram Bot Token (из BotFather)
TELEGRAM_BOT_TOKEN=

# PostgreSQL (async). В docker compose для migrate и backend переопределяется на сервис db
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/morlana_db

# Redis. В docker compose для migrate и backend переопределяется на сервис redis
REDIS_URL=redis://localhost:6379/0

# LLM API (MiMo / OpenAI-compatible). Пустой LLM_BASE_URL — адрес OpenAI по умолчанию
LLM_API_KEY=
LLM_BASE_URL=
LLM_FREE_MODEL=mimo-v2.5
LLM_PREMIUM_MODEL=mimo-v2.5-pro

# Telegram Payments (BotFather → Payments). Пока не используется: роут оплаты не подключён
PAYMENT_PROVIDER_TOKEN=

# CORS (через запятую, без пробелов)
CORS_ORIGINS=http://localhost:3000

# Только для локальной разработки. При true запрос без подписи Telegram считается dev-аккаунтом.
# Backend не стартует, если при DEV_MODE=true в CORS_ORIGINS есть адрес не с localhost/127.0.0.1
# (например, ngrok). Приложение, открытое наружу, всегда запускайте с false
DEV_MODE=false

# Сколько секунд действует initData от Telegram (по auth_date); 86400 — сутки
INIT_DATA_MAX_AGE=86400

# Сколько архивных раскладов отдаёт история: без подписки и с подпиской.
# Старые расклады из базы не удаляются, лимит действует только при чтении
HISTORY_LIMIT_FREE=3
HISTORY_LIMIT_PREMIUM=50
